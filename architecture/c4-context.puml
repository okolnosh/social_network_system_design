@startuml c4-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C4 Level 1 — Социальная сеть для путешественников

Person(traveler, "Путешественник", "Публикует посты о путешествиях с фото и геопривязкой, читает ленту, ставит лайки и комментарии, подписывается на других путешественников, ищет популярные места")

System(travelNetwork, "Социальная сеть для путешественников", "Публикация постов с фотографиями и привязкой к месту, лента по подпискам, реакции (лайки/комментарии), подписки, поиск популярных мест")


Rel(traveler, travelNetwork, "Публикует посты, читает ленту и профили, ставит лайки/комментарии, управляет подписками, ищет места", "HTTPS")

@enduml
